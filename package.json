{
  "name": "emi-calculator-playwright-assessment",
  "version": "0.1.0",
  "private": true,
  "description": "EMI calculator with unit, Playwright, Cucumber, API boundary, and SQL assessment coverage.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test --experimental-test-coverage tests/unit/emi.test.cjs",
    "test": "cucumber-js",
    "test:api": "playwright test tests/api",
    "test:ui": "cucumber-js",
    "test:self-heal": "cucumber-js --tags @self-heal",
    "test:all": "npm run test:unit && npm run test:api && npm run test:ui"
  },
  "dependencies": {
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4"
  }
}
